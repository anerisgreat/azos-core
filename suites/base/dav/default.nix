{...}: {
  config.flake.modules.homeManager.base = {
    lib,
    config,
    pkgs,
    ...
  }: let
    cfg = config.azos.dav;
    vdirsyncer = "${config.programs.vdirsyncer.package}/bin/vdirsyncer";
    todo = "${pkgs.todoman}/bin/todo";
    davAccounts = lib.filterAttrs (_: a: a.vdirsyncer.enable) config.accounts.calendar.accounts;

    # `vdirsyncer discover` prompts for every collection missing on either
    # side, and aborts if stdin is closed. Explicitly listed collections are
    # pre-created locally and every prompt answered "no", so a typo'd list
    # name fails loudly instead of silently creating a new list on the
    # server. "from a" (all remote lists) can only ever be missing locally,
    # so answering "yes" there just creates local directories.
    discoverAccount = name: a: let
      cols =
        if a.vdirsyncer.collections == null
        then []
        else a.vdirsyncer.collections;
      explicit = lib.filter (c: lib.isString c && !(lib.hasPrefix "from " c)) cols;
      answer =
        if lib.elem "from a" cols
        then "y"
        else "n";
    in ''
      ${lib.concatMapStrings (c: "mkdir -p ${lib.escapeShellArg "${a.local.path}/${c}"}\n") explicit}
      # home-manager's vdirsyncer module names each calendar pair calendar_<account>.
      if ! out=$(${vdirsyncer} discover ${lib.escapeShellArg "calendar_${name}"} 2>&1 < <(${pkgs.coreutils}/bin/yes ${answer})); then
        echo "$out" >&2
        exit 1
      fi
    '';

    orgView = pkgs.writeShellScriptBin "azos-dav-org-view" ''
      set -euo pipefail
      out=${lib.escapeShellArg cfg.orgView.file}
      mkdir -p "$(dirname "$out")"
      tmp=$(mktemp "$out.XXXXXX")
      {
        echo "# -*- buffer-read-only: t -*-"
        echo "#+title: DAV todos"
        echo "# Generated by azos-dav-sync -- do not edit. Change items on the"
        echo "# phone or with todoman (todo), then run azos-dav-sync."
        echo
        ${todo} --porcelain list | LC_ALL=C ${pkgs.jq}/bin/jq -r -f ${./org-view.jq}
      } > "$tmp"
      mv "$tmp" "$out"
    '';

    sync = pkgs.writeShellScriptBin "azos-dav-sync" ''
      set -euo pipefail
      state=${lib.escapeShellArg cfg.stateDir}
      mkdir -p "$state"
      ${lib.optionalString (cfg.presenceCheckCommand != null) ''
        if ! ${cfg.presenceCheckCommand}; then
          echo "azos-dav-sync: presence check failed, not syncing." \
            "Last successful sync: $(cat "$state/last-sync" 2>/dev/null || echo never)" >&2
          exit 75
        fi
      ''}
      ${lib.concatStrings (lib.mapAttrsToList discoverAccount davAccounts)}
      ${vdirsyncer} metasync
      ${vdirsyncer} sync
      date -Iseconds > "$state/last-sync"
      ${lib.optionalString cfg.orgView.enable "${orgView}/bin/azos-dav-org-view"}
    '';
  in {
    options.azos.dav.enable = lib.mkOption {
      default = false;
      example = true;
      type = lib.types.bool;
      description = ''
        Two-way sync of DAV task lists (e.g. Nextcloud CalDAV lists that
        Apple Reminders also syncs to) to local vdirs via vdirsyncer, with
        todoman (`todo`) as the CLI over them.

        Accounts are declared with home-manager's own
        accounts.calendar.accounts.<name> (remote.*, vdirsyncer.enable,
        vdirsyncer.collections) -- this module wires up the sync service,
        defaults and an org view on top. Run `azos-dav-sync` to sync
        immediately.
      '';
    };
    options.azos.dav.presenceCheckCommand = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      description = ''
        Optional shell command checked before each sync; if it exits
        non-zero, azos-dav-sync skips the sync and exits 75, reporting the
        last successful sync time. Same idea as azos.mail.presenceCheckCommand
        -- avoids a pinentry prompt on a timer when the passwordCommand needs
        a smartcard that isn't plugged in.
      '';
    };
    options.azos.dav.frequency = lib.mkOption {
      type = lib.types.str;
      default = "10m";
      description = "How often the background sync runs (systemd time span).";
    };
    options.azos.dav.stateDir = lib.mkOption {
      type = lib.types.str;
      default = "${config.xdg.dataHome}/azos-dav";
      description = ''
        Holds the synced calendars (the default accounts.calendar.basePath),
        the last-sync timestamp and the default org view file.
      '';
    };
    options.azos.dav.orgView.enable = lib.mkOption {
      default = true;
      type = lib.types.bool;
      description = ''
        Regenerate a read-only org file of open DAV todos after every sync
        and add it to org-agenda-files.
      '';
    };
    options.azos.dav.orgView.file = lib.mkOption {
      type = lib.types.str;
      default = "${cfg.stateDir}/todos.org";
    };

    # Defaults for every calendar account: the server (the phone) wins
    # conflicts, and list display names are synced so todoman shows
    # "Reminders" rather than an opaque collection id.
    options.accounts.calendar.accounts = lib.mkOption {
      type = lib.types.attrsOf (lib.types.submodule {
        config.vdirsyncer = lib.mkIf cfg.enable {
          conflictResolution = lib.mkDefault "remote wins";
          metadata = lib.mkDefault ["displayname" "color"];
        };
      });
    };

    config = lib.mkIf cfg.enable (lib.mkMerge [
      {
        accounts.calendar.basePath = lib.mkDefault "${cfg.stateDir}/calendars";
        programs.vdirsyncer.enable = true;
        programs.todoman = {
          enable = true;
          glob = "*/*";
          extraConfig = ''
            date_format = "%Y-%m-%d"
            time_format = "%H:%M"
            humanize = False
          '';
        };
        home.packages = [sync] ++ lib.optional cfg.orgView.enable orgView;

        systemd.user.services.azos-dav-sync = {
          Unit.Description = "Sync DAV task lists (skips if the presence check fails)";
          Service = {
            Type = "oneshot";
            ExecStart = "${sync}/bin/azos-dav-sync";
            SuccessExitStatus = "75";
          };
        };
        systemd.user.timers.azos-dav-sync = {
          Unit.Description = "Periodic DAV task list sync";
          Timer = {
            OnStartupSec = "2m";
            OnUnitActiveSec = cfg.frequency;
          };
          Install.WantedBy = ["timers.target"];
        };
      }

      (lib.mkIf cfg.orgView.enable {
        # Placeholder so org-agenda doesn't prompt about a missing agenda
        # file before the first sync.
        home.activation.azosDavOrgView = lib.hm.dag.entryAfter ["writeBoundary"] ''
          if [ ! -e ${lib.escapeShellArg cfg.orgView.file} ]; then
            $DRY_RUN_CMD mkdir -p "$(dirname ${lib.escapeShellArg cfg.orgView.file})"
            $DRY_RUN_CMD touch ${lib.escapeShellArg cfg.orgView.file}
          fi
        '';
      })

      (lib.mkIf (cfg.orgView.enable && config.azos.emacs.enable) {
        home.file.".emacs.d/extra/azos-dav.el".text = ''
          ;;; -*- lexical-binding: t; -*-
          ;; Generated by azos-core (suites/base/dav).
          (with-eval-after-load 'org
            (add-to-list 'org-agenda-files "${cfg.orgView.file}" t))
        '';
      })
    ]);
  };
}
