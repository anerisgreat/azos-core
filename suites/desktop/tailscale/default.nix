# Tailscale client helper: azos-tailscale-up joins this machine to a tailnet;
# M-o T and a tab-bar status icon live in emacs/config.org.
{...}: {
  config.flake.modules.homeManager.desktop = {
    lib,
    config,
    pkgs,
    ...
  }: let
    cfg = config.azos.tailscale;

    # `tailscale up` insists that non-default flags are restated on every
    # call, so the script and the Emacs command share this exact set.
    upArgs =
      cfg.extraUpArgs
      ++ lib.optional (cfg.loginServer != null) "--login-server=${cfg.loginServer}";

    tailscaleUp = pkgs.writeShellApplication {
      name = "azos-tailscale-up";
      text = ''
        command -v tailscale >/dev/null \
          || { echo "tailscale is not installed" >&2; exit 1; }
        ARGS=(--operator="$USER" ${lib.escapeShellArgs upArgs})
        ${lib.optionalString (cfg.authKeyEntry != null) ''
          ARGS+=(--auth-key="$(azos-password-get ${lib.escapeShellArg cfg.authKeyEntry})")
        ''}
        sudo tailscale up "''${ARGS[@]}" "$@"
        tailscale status
      '';
    };
  in {
    options.azos.tailscale = {
      enable = lib.mkOption {
        default = false;
        example = true;
        type = lib.types.bool;
        description = ''
          The Tailscale client helper (azos-tailscale-up) and Emacs
          integration (M-o T, tab-bar icon). The daemon (tailscaled) is NOT
          installed: it needs root and /dev/net/tun. On NixOS set
          services.tailscale.enable; elsewhere install it from the distro or
          Tailscale's package repository.
        '';
      };
      authKeyEntry = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = ''
          Password-manager entry holding a (reusable, tagged) auth key for
          unattended login. Null prints a login URL to open instead.
        '';
      };
      extraUpArgs = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [];
        example = ["--accept-routes" "--ssh"];
        description = "Extra flags for `tailscale up`, besides --operator=$USER.";
      };
      loginServer = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = "Control server URL (--login-server), only for a self-hosted one such as Headscale.";
      };
      tabBarIcon = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Show the connection state in the Emacs tab bar.";
      };
    };

    config = lib.mkIf cfg.enable (lib.mkMerge [
      {home.packages = [tailscaleUp];}

      (lib.mkIf config.azos.emacs.enable {
        azos.emacs.pkgs = [pkgs.azos-emacs-tailscale];
        azos.emacs.enabledSuites = ["azos-emacs-tailscale"];
        home.file.".emacs.d/extra/azos-tailscale.el".text = ''
          ;;; -*- lexical-binding: t; -*-
          ;; Generated by azos-core (suites/desktop/tailscale).
          (setq azos/tailscale/up-args '(${lib.concatMapStringsSep " " builtins.toJSON upArgs}))
          ${lib.optionalString cfg.tabBarIcon ''
            (with-eval-after-load 'azos-emacs-tailscale
              (azos/tailscale/enable-tab-display))
          ''}'';
      })
    ]);
  };
}
