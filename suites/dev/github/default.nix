# GitHub: the gh CLI, and Forge / pr-review inside Magit, optionally with the
# API token served from the password manager (emacs/config.org).
{...}: {
  config.flake.modules.homeManager.dev = {
    lib,
    config,
    pkgs,
    ...
  }: let
    cfg = config.azos.github;
  in {
    options.azos.github = {
      enable = lib.mkOption {
        default = false;
        example = true;
        type = lib.types.bool;
        description = "GitHub tooling: gh, Forge and pr-review.";
      };
      user = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        example = "octocat";
        description = ''
          GitHub user name, set as git's github.user. Forge/ghub build their
          token lookup ("<github.user>^forge") from it. Null leaves
          github.user unset.
        '';
      };
      tokenEntry = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        example = "github/%u";
        description = ''
          Password-manager entry (read with azos-password-get) holding a
          classic token with the repo and read:org scopes, served to Forge
          for api.github.com. A %u is replaced by the GitHub user name. Null
          leaves ghub on plain auth-source.
        '';
      };
    };

    config = lib.mkIf cfg.enable (lib.mkMerge [
      {
        home.packages = [pkgs.gh];
        programs.git.settings.github.user = lib.mkIf (cfg.user != null) cfg.user;
      }

      (lib.mkIf config.azos.emacs.enable {
        azos.emacs.pkgs = [pkgs.azos-emacs-github];
        azos.emacs.enabledSuites = ["azos-emacs-github"];
        home.file.".emacs.d/extra/azos-github.el".text = ''
          ;;; -*- lexical-binding: t; -*-
          ;; Generated by azos-core (suites/dev/github).
          (setq azos/github/token-entry ${
            if cfg.tokenEntry == null
            then "nil"
            else builtins.toJSON cfg.tokenEntry
          })
        '';
      })
    ]);
  };
}
