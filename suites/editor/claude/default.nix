# Claude Code: the CLI with azos' org-roam memory and skills, and in Emacs
# claude-code-ide (the real CLI in vterm, bridged to Emacs over MCP) on the
# M-o a keys and the tab-bar session squares that agent-shell had.
# agent-shell stays installed (M-x agent-shell) and starts Claude Code too.
{...}: {
  config.flake.modules.homeManager.editor = {
    lib,
    config,
    pkgs,
    ...
  }: let
    cfg = config.azos.claude;
  in {
    options.azos.claude = {
      enable = lib.mkOption {
        default = false;
        example = true;
        type = lib.types.bool;
        description = "Claude Code, with the claude backends of agent-memory and agent-skills.";
      };
      agentShellDefault = lib.mkOption {
        default = cfg.enable;
        defaultText = lib.literalExpression "config.azos.claude.enable";
        type = lib.types.bool;
        description = "Make agent-shell start Claude Code instead of asking which agent to use.";
      };
      ide.enable = lib.mkOption {
        default = cfg.enable;
        defaultText = lib.literalExpression "config.azos.claude.enable";
        type = lib.types.bool;
        description = ''
          claude-code-ide in Emacs: M-o a s/S/i open, switch between and
          drive Claude Code sessions, whose states show as squares in the tab
          bar (replacing agent-shell's there).
        '';
      };
    };

    config = lib.mkMerge [
      (lib.mkIf cfg.enable {
        home.packages = with pkgs; [claude-code claude-agent-acp];
        azos.agent-memory.backends.claude.enable = lib.mkDefault true;
        azos.agent-skills.backends.claude.enable = lib.mkDefault true;
      })

      (lib.mkIf (cfg.enable && config.azos.emacs.enable) {
        home.file.".emacs.d/extra/azos-claude.el".text = lib.concatStringsSep "\n" ([
            ";;; -*- lexical-binding: t; -*-"
            ";; Generated by azos-core (suites/editor/claude)."
          ]
          ++ lib.optional cfg.agentShellDefault "(setq agent-shell-preferred-agent-config 'claude-code)"
          ++ lib.optional cfg.speak.enable "(setq azos/claude/speak-enabled t)"
          ++ [""]);
      })

      (lib.mkIf (cfg.ide.enable && config.azos.emacs.enable) {
        # The CLI status line set up in emacs/config.org uses jq.
        home.packages = [pkgs.jq];
        azos.emacs.pkgs = [pkgs.azos-emacs-claude];
        azos.emacs.enabledSuites = ["azos-emacs-claude"];
      })
    ];
  };
}
