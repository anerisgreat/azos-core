# Claude Code: the CLI with azos' org-roam memory and skills, and in Emacs
# claude-code-ide (the real CLI in vterm, bridged to Emacs over MCP) on the
# M-o a keys and the tab-bar session squares that agent-shell had.
# agent-shell stays installed (M-x agent-shell) and starts Claude Code too.
{...}: {
  config.flake.modules.homeManager.editor = {
    lib,
    config,
    pkgs,
    ...
  }: let
    cfg = config.azos.claude;
  in {
    options.azos.claude = {
      enable = lib.mkOption {
        default = false;
        example = true;
        type = lib.types.bool;
        description = "Claude Code, with the claude backends of agent-memory and agent-skills.";
      };
      agentShellDefault = lib.mkOption {
        default = cfg.enable;
        defaultText = lib.literalExpression "config.azos.claude.enable";
        type = lib.types.bool;
        description = "Make agent-shell start Claude Code instead of asking which agent to use.";
      };
      voice.enable = lib.mkOption {
        default = false;
        example = true;
        type = lib.types.bool;
        description = ''
          Turn on Claude Code's voice dictation in tap mode (Space starts and
          stops recording) in ~/.claude/settings.json, rather than with
          /voice. Only those keys are set; turning this off leaves them.
        '';
      };
      theme.enable = lib.mkOption {
        default = false;
        example = true;
        type = lib.types.bool;
        description = ''
          A Claude Code theme matching Emacs (the built-in light theme with
          LightYellow and Emacs' diff, region and link colours), installed
          as ~/.claude/themes/emacs.json and selected in settings.json.
          Claude Code reloads ~/.claude/themes/ live, but only if the folder
          existed when it started.
        '';
      };
      ide.enable = lib.mkOption {
        default = cfg.enable;
        defaultText = lib.literalExpression "config.azos.claude.enable";
        type = lib.types.bool;
        description = ''
          claude-code-ide in Emacs: M-o a s/S/i open, switch between and
          drive Claude Code sessions, whose states show as squares in the tab
          bar (replacing agent-shell's there).
        '';
      };
    };

    config = lib.mkMerge [
      (lib.mkIf cfg.enable {
        home.packages = with pkgs; [claude-code claude-agent-acp];
        azos.agent-memory.backends.claude.enable = lib.mkDefault true;
        azos.agent-skills.backends.claude.enable = lib.mkDefault true;
      })

      (lib.mkIf (cfg.enable && cfg.voice.enable) {
        # /voice writes both the voice object and the older voiceEnabled
        # (Claude Code reads voice.enabled first), so set both the same way.
        home.activation.claudeVoice = lib.hm.dag.entryAfter ["writeBoundary"] ''
          SETTINGS_JSON="$HOME/.claude/settings.json"
          [ -f "$SETTINGS_JSON" ] || echo '{}' > "$SETTINGS_JSON"
          tmp=$(mktemp)
          ${pkgs.jq}/bin/jq '.voice.enabled = true | .voice.mode = "tap" | .voiceEnabled = true' \
            "$SETTINGS_JSON" > "$tmp" && mv "$tmp" "$SETTINGS_JSON"
        '';
      })

      (lib.mkIf (cfg.enable && cfg.theme.enable) {
        home.file.".claude/themes/emacs.json" = {
          source = ./theme/emacs.json;
          # Replaces a hand-written copy, if there is one.
          force = true;
        };

        # settings.json is also written by Claude Code and other activation
        # steps, so set just the key.
        home.activation.claudeTheme = lib.hm.dag.entryAfter ["writeBoundary"] ''
          SETTINGS_JSON="$HOME/.claude/settings.json"
          [ -f "$SETTINGS_JSON" ] || echo '{}' > "$SETTINGS_JSON"
          tmp=$(mktemp)
          ${pkgs.jq}/bin/jq '.theme = "custom:emacs"' "$SETTINGS_JSON" > "$tmp" \
            && mv "$tmp" "$SETTINGS_JSON"
        '';
      })

      (lib.mkIf (cfg.enable && config.azos.emacs.enable) {
        home.file.".emacs.d/extra/azos-claude.el".text = lib.concatStringsSep "\n" ([
            ";;; -*- lexical-binding: t; -*-"
            ";; Generated by azos-core (suites/editor/claude)."
          ]
          ++ lib.optional cfg.agentShellDefault "(setq agent-shell-preferred-agent-config 'claude-code)"
          ++ lib.optional cfg.speak.enable "(setq azos/claude/speak-enabled t)"
          ++ [""]);
      })

      (lib.mkIf (cfg.ide.enable && config.azos.emacs.enable) {
        # The CLI status line set up in emacs/config.org uses jq.
        home.packages = [pkgs.jq];
        azos.emacs.pkgs = [pkgs.azos-emacs-claude];
        azos.emacs.enabledSuites = ["azos-emacs-claude"];
      })
    ];
  };
}
