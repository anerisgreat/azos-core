{...}: {
  config.flake.modules.homeManager.exwm = {
    lib,
    config,
    pkgs,
    ...
  }: {
    options.azos.suites.exwm.enable = lib.mkOption {
      default = false;
      type = lib.types.bool;
    };
    options.azos.exwm.lockCommand = lib.mkOption {
      default = "slock";
      example = "xsecurelock";
      type = lib.types.str;
      description = ''
        Shell command s-<f2> runs to lock the screen. X lockers need
        privileges a user-level Nix install can't grant (setuid, PAM), so
        install the locker on the host (NixOS: programs.slock.enable;
        Fedora: dnf install slock) and refer to it here.
      '';
    };
    config = lib.mkIf config.azos.suites.exwm.enable {
      azos.suites.base.enable = lib.mkDefault true;
      azos.suites.desktop.enable = lib.mkDefault true;

      # EDNC (Emacs Desktop Notification Center) runs as the notification
      # daemon instead — see azos-core/suites/exwm/emacs/config.org.
      services.dunst.enable = lib.mkForce false;

      # libnotify's notify-send is the standard way for arbitrary scripts
      # (not just Emacs itself) to post to the org.freedesktop.Notifications
      # bus that EDNC serves -- without it nothing outside Emacs has a
      # straightforward way to raise a desktop notification.
      # playerctl is what desktop-environment's music commands shell out to
      # (see the XF86Audio{Play,Stop,Prev,Next} bindings in
      # exwm/emacs/config.org) -- Spotify's Linux client exposes an MPRIS
      # D-Bus interface, so playerctl drives it the same as any other player.
      #
      # xrandr/xlayoutdisplay/xdpyinfo/brightnessctl/xdg-utils are called from
      # exwm/emacs/config.org; NixOS hosts also get some of them system-wide
      # from nixos-base, but non-NixOS hosts only have what's installed here.
      home.packages = with pkgs; [
        ffmpeg-full
        imv
        xkb-switch
        libnotify
        playerctl
        xrandr
        xlayoutdisplay
        xdpyinfo
        brightnessctl
        xdg-utils
      ];
      xdg.mimeApps.defaultApplications = {"image/gif" = "imv.desktop";};
      services.udiskie = {
        enable = true;
        tray = "never";
      };
      # ~/.xsession imports the X environment into systemd --user, starts
      # graphical-session.target (so WantedBy=graphical-session.target user
      # services such as udiskie, flameshot and setxkbmap actually run), runs
      # Emacs as the window manager and stops the target when it exits.
      # startx (NixOS/greetd) reaches it through ~/.xinitrc; display managers
      # on other distros can launch it directly as a session.
      xsession = {
        enable = true;
        windowManager.command = "emacs";
      };
      home.file.".xinitrc" = {
        text = ''
          exec /bin/sh "$HOME/.xsession"
        '';
      };
      home.file.".emacs.d/extra/azos-exwm-host.el".text = ''
        ;;; -*- lexical-binding: t; -*-
        ;; Generated by azos exwm suite.
        (setq azos/exwm/lock-command ${builtins.toJSON config.azos.exwm.lockCommand})
      '';
      home.file.".login.sh" = {
        text = ''
          #!/usr/bin/env bash
          ${pkgs.xinit}/bin/startx
        '';
        executable = true;
      };
    };
  };

  config.flake.modules.nixos.exwm = {
    lib,
    config,
    pkgs,
    ...
  }: {
    options.azos.suites.exwm.enable = lib.mkOption {
      default = false;
      type = lib.types.bool;
    };
    config = lib.mkMerge [
      (lib.mkIf config.azos.suites.exwm.enable {
        services.udisks2.enable = true;
      })
      {
        warnings = lib.optionals (!config.azos.suites.exwm.enable) (
          lib.concatLists (lib.mapAttrsToList
            (user: userCfg:
              lib.optional userCfg.azos.suites.exwm.enable
              "azos.suites.exwm is enabled for home-manager user '${user}' but disabled at the NixOS level. udisks2 will not be available.")
            config.home-manager.users)
        );
      }
    ];
  };
}
